{
  "models": [
    {
      "id": "page",
      "title": "Page"
    },
    {
      "id": "page-metadata",
      "title": "Page Metadata",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "jcr:title",
          "label": "Page Title"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "jcr:description",
          "label": "Page Description"
        },

        {
          "component": "text",
          "valueType": "string",
          "name": "cardTitle",
          "label": "Card Title",
          "description": "Title shown in listings (News, Blogs, Stories, etc.)"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "cardTeaser",
          "label": "Card Teaser",
          "description": "Short summary shown below the title"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "publishDate",
          "label": "Publish Date (YYYY-MM-DD)"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "contentType",
          "label": "Content Type",
          "description": "news | blog | story | case-study"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "contentAudience",
          "label": "Show In Sections",
          "description": "Comma separated values. Example: aero, energy, corporate"
        },
        {
          "component": "checkbox",
          "valueType": "boolean",
          "name": "featured",
          "label": "Featured Content",
          "default": false
        },
        {
          "component": "checkbox",
          "valueType": "boolean",
          "name": "showInListing",
          "label": "Show in Listings",
          "default": true
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "cardPriority",
          "label": "Card Priority (1 = highest)",
          "description": "Lower number appears first. Leave empty for normal order."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "ctaLabel",
          "label": "CTA Label",
          "description": "Example: Read More"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "ctaLink",
          "label": "CTA Link URL",
          "description": "Optional override. Defaults to page URL."
        }
      ]
    }
  ]
}
