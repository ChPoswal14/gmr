{
  "models": [
    {
      "id": "page",
      "title": "Page"
    },
    {
      "id": "page-metadata",
      "title": "Page Metadata",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "jcr:title",
          "label": "Page Title"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "jcr:description",
          "label": "Page Description"
        },

        {
          "component": "text",
          "valueType": "string",
          "name": "cardTitle",
          "label": "Card Title",
          "description": "Headline shown on listing cards"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "cardTeaser",
          "label": "Card Teaser (optional)",
          "description": "Optional teaser text (not always displayed)"
        },

        {
          "component": "text",
          "valueType": "string",
          "name": "cardImage",
          "label": "Card Image (DAM Path)",
          "description": "Example: /content/dam/gmr/news/delhi-airport.jpg"
        },

        {
          "component": "text",
          "valueType": "string",
          "name": "publishDate",
          "label": "Publish Date (YYYY-MM-DD)"
        },

        {
          "component": "text",
          "valueType": "string",
          "name": "contentType",
          "label": "Content Type",
          "description": "news, blog, story, case-study"
        },

        {
          "component": "text",
          "valueType": "string",
          "name": "contentAudience",
          "label": "Audience / Sections",
          "description": "Comma-separated: aero, energy, corporate"
        },

        {
          "component": "checkbox",
          "valueType": "boolean",
          "name": "featured",
          "label": "Featured Content",
          "default": false
        },

        {
          "component": "checkbox",
          "valueType": "boolean",
          "name": "showInListing",
          "label": "Show in Listings",
          "default": true
        },

        {
          "component": "number",
          "valueType": "number",
          "name": "cardPriority",
          "label": "Card Priority (1 = highest)",
          "default": 100
        },

        {
          "component": "text",
          "valueType": "string",
          "name": "ctaLabel",
          "label": "CTA Label",
          "default": "Read More"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "ctaLink",
          "label": "CTA Link (optional)",
          "description": "Leave empty to auto-link to the page"
        }
      ]
    }
  ]
}
